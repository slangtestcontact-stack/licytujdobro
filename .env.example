DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/licytujdobro
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
SESSION_SECRET=change-me-at-least-32-characters
CRON_SECRET=change-me-cron-secret
HANDOVER_CODE_SECRET=change-me-handover-code-secret-at-least-32-characters

PILOT_CITY="Biłgoraj"
NEXT_PUBLIC_PILOT_CITY="Biłgoraj i okolice"
ADMIN_EMAIL=admin@example.pl
ADMIN_PHONE=+48500100200
ADMIN_PASSWORD=ChangeMe-Strong-Password-123!
ADMIN_FIRST_NAME=Administrator
ADMIN_NICKNAME=Administrator

# Szybkie logowanie OAuth (opcjonalne lokalnie; wymagane na produkcji dla przycisków Google/Facebook/Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Klucz .p8 jako jedna linia; znaki nowej linii zapisz jako \n
APPLE_PRIVATE_KEY=
OAUTH_STATE_SECRET=change-me-oauth-state-secret-at-least-32-characters
EMAIL_LOGIN_SECRET=change-me-email-login-secret-at-least-32-characters

# Wymagany kontakt przed licytacją/wystawieniem:
# both = e-mail i telefon, either = e-mail albo telefon, email = tylko e-mail, phone = tylko telefon
CONTACT_VERIFICATION_MODE=email

# Produkcyjna wysyłka. W trybie dev wiadomości są wypisywane w konsoli.
# E-mail: dev (kody w terminalu), resend albo http
EMAIL_PROVIDER=dev
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=LicytujDobro <powiadomienia@example.pl>

# SMS jest opcjonalny i domyślnie nie jest wymagany do konta ani licytacji.
SMS_PROVIDER=dev
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=LicytujDobro
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Zdjęcia: local podczas developmentu albo r2 na produkcji.
OBJECT_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=licytujdobro-public
R2_PRIVATE_BUCKET=licytujdobro-private
# Własna domena publicznego bucketa, np. https://img.licytujdobro.pl
R2_PUBLIC_URL=

# Organizator i dane prawne widoczne publicznie.
# ORGANIZER_LEGAL_NAME, ORGANIZER_ADDRESS i ORGANIZER_EMAIL są wymagane przed produkcją.
ORGANIZER_NAME=LicytujDobro
ORGANIZER_LEGAL_NAME=
ORGANIZER_ADDRESS=
ORGANIZER_EMAIL=
ORGANIZER_PHONE=
ORGANIZER_NIP=
# Np. KRS 0000000000, REGON 000000000 albo informacja o osobie fizycznej nieprowadzącej działalności.
ORGANIZER_REGISTRY=
ORGANIZER_HOURS=Poniedziałek–piątek, 17:00–20:00

# Punkty kontaktowe. Mogą wskazywać ten sam adres co ORGANIZER_EMAIL.
PRIVACY_EMAIL=
DSA_CONTACT_EMAIL=

# Wersje dokumentów i końcowa zgoda na publikację.
LEGAL_VERSION=1.0
LEGAL_EFFECTIVE_DATE=2026-07-30
LEGAL_LAST_UPDATED_DATE=2026-07-30
LEGAL_BIDDING_TERMS_VERSION=2026-07-v2
# Ustaw true dopiero po uzupełnieniu danych operatora i przeglądzie dokumentów pod kątem faktycznego modelu działania.
LEGAL_PUBLISH_READY=false

# Ustaw true dopiero po uzyskaniu i zapisaniu zgody rodzica/opiekuna
FAMILY_NAME_CONSENT_CONFIRMED=false
FAMILY_PHOTO_CONSENT_CONFIRMED=false
FAMILY_STORY_CONSENT_CONFIRMED=false

# Produkcja/test
PRODUCTION_URL=https://licytujdobro.pl
TEST_URL=https://test.licytujdobro.pl
BACKUP_DIRECTORY=./backups
# Osobna, pusta baza używana wyłącznie do testu odtwarzania kopii
RESTORE_TEST_DATABASE_URL=

# Opcjonalny webhook monitoringu błędów efektów ubocznych
ERROR_MONITOR_WEBHOOK_URL=

# Transparentność publiczna
CAMPAIGN_LINK_VERIFIED_AT=2026-07-29

# Monitoring wydajności SQL
SLOW_QUERY_MS=750
SLOW_QUERY_MONITOR_WEBHOOK_URL=

# Alarm gotowości, gdy backup jest starszy niż limit
BACKUP_MAX_AGE_HOURS=36

# Lokalnie pozostaw false, aby nie kompilować endpointu metryk przy pierwszym kliknięciu.
WEB_VITALS_ENABLED=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
